                    <a href="/configurador"
                       class="r3d-home-machine-card">

                        <div class="r3d-home-machine-image r3d-home-identity">
                        </div>

                        <div class="r3d-home-machine-card-content">

                            <h3>IDENTITY</h3>

                            <strong>
                                Precisión sin límites.
                            </strong>

                            <p>
                                Máxima calidad dimensional
                                para piezas técnicas.
                            </p>

