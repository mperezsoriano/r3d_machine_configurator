<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="configurator_page" name="Configurador R3DIMENSION">

        <t t-call="website.layout">

            <div id="wrap">

                <section class="r3d-configurator">

                    <div class="r3d-configurator-container">


                        <!-- =================================================
                             CABECERA
                             ================================================= -->

                        <div class="r3d-configurator-header">

                            <h1>
                                Configura tu impresora 3D industrial
                            </h1>

                            <p>
                                Configura una máquina adaptada a las necesidades
                                reales de tu producción.
                            </p>


                            <!-- SELECTOR DE MÁQUINAS -->

                            <div class="r3d-machine-selector">

                                <t t-foreach="machines" t-as="machine">

                                    <button
                                        type="button"
                                        t-att-class="'r3d-machine-button active' if machine == machines[:1] else 'r3d-machine-button'"
                                        t-att-data-machine-id="machine.id"
                                        t-att-data-machine-name="machine.name"
                                        t-att-data-machine-price="machine.base_price">

                                        <t t-esc="machine.name"/>

                                    </button>

                                </t>

                            </div>

                        </div>


                        <!-- =================================================
                             CUERPO DEL CONFIGURADOR
                             ================================================= -->

                        <div class="r3d-configurator-main">


                            <!-- =================================================
                                 COLUMNA IZQUIERDA
                                 ================================================= -->

                            <div class="r3d-configurator-left">


                                <!-- =============================================
                                     VISUALIZACIÓN DE LA MÁQUINA
                                     ============================================= -->

                                <div class="r3d-machine-view">


                                    <!-- INFORMACIÓN DEL MODELO -->

                                    <div class="r3d-machine-info">

                                        <div class="r3d-machine-info-label">
                                            R3DIMENSION
                                        </div>

                                        <h2 class="r3d-visual-machine-name">
                                            IDENTITY
                                        </h2>

                                        <p class="r3d-visual-machine-description">
                                            Fabricación aditiva industrial de gran formato,
                                            diseñada para producción y piezas funcionales.
                                        </p>

                                    </div>


                                    <!-- IMAGEN -->

                                    <div class="r3d-machine-visual">

                                        <t t-if="machines">

                                            <img
                                                class="r3d-machine-image"
                                                src="/r3d_machine_configurator/static/src/img/identity.png"
                                                alt="R3DIMENSION IDENTITY"/>

                                        </t>

                                    </div>


                                    <!-- CARACTERÍSTICAS -->

                                    <div class="r3d-machine-features">

                                        <div class="r3d-machine-feature">

                                            <span>01</span>

                                            <strong>
                                                GRAN FORMATO
                                            </strong>

                                        </div>


                                        <div class="r3d-machine-feature">

                                            <span>02</span>

                                            <strong>
                                                IDEX
                                            </strong>

                                        </div>


                                        <div class="r3d-machine-feature">

                                            <span>03</span>

                                            <strong class="r3d-feature-third">
                                                ALTA VELOCIDAD
                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <!-- =================================================
                                     ZONA DE SELECCIÓN DE CONFIGURACIÓN
                                     ================================================= -->

                                <div class="r3d-configuration-sections">

                                    <t t-foreach="machines" t-as="machine">

                                        <div
                                            t-att-class="'r3d-machine-options active' if machine == machines[:1] else 'r3d-machine-options'"
                                            t-att-data-machine-id="machine.id">


                                            <!-- =====================================
                                                 CABECERA DE CONFIGURACIÓN
                                                 ===================================== -->

                                            <div class="r3d-configuration-section-header">

                                                <span class="r3d-configuration-step">
                                                    CONFIGURACIÓN
                                                </span>

                                                <h2>
                                                    Configura tu
                                                    <t t-esc="machine.name"/>
                                                </h2>

                                                <p>
                                                    Selecciona el equipamiento y las
                                                    opciones que mejor se adapten a
                                                    tus necesidades de producción.
                                                </p>

                                            </div>


                                            <!-- =====================================
                                                 OPCIONES
                                                 ===================================== -->

                                            <div class="r3d-configuration-options">

                                                <t
                                                    t-foreach="machine.configuration_ids"
                                                    t-as="config">

                                                    <t t-if="config.available">


                                                        <!-- =========================
                                                             OPCIÓN INCLUIDA
                                                             ========================= -->

                                                        <div
                                                            t-if="config.included"
                                                            class="r3d-config-card r3d-config-card-included">


                                                            <!-- CABECERA -->

                                                            <div class="r3d-config-card-top">

                                                                <span class="r3d-config-card-status">
                                                                    INCLUIDO
                                                                </span>

                                                                <span class="r3d-config-card-check">
                                                                    ✓
                                                                </span>

                                                            </div>


                                                            <!-- CUERPO -->

                                                            <div class="r3d-config-card-body">


                                                                <!-- IMAGEN -->

                                                                <div class="r3d-config-card-image">

                                                                    <span>
                                                                        IMAGEN
                                                                    </span>

                                                                </div>


                                                                <!-- INFORMACIÓN -->

                                                                <div class="r3d-config-card-content">

                                                                    <h3>
                                                                        <t t-esc="config.option_id.name"/>
                                                                    </h3>

                                                                    <p>
                                                                        Lorem ipsum dolor sit amet,
                                                                        consectetur adipiscing elit.
                                                                        Sed do eiusmod tempor incididunt
                                                                        ut labore et dolore magna aliqua.
                                                                    </p>

                                                                </div>

                                                            </div>

                                                        </div>


                                                        <!-- =========================
                                                             EXTRA SELECCIONABLE
                                                             ========================= -->

                                                        <label
                                                            t-else=""
                                                            class="r3d-config-card r3d-config-card-selectable">

                                                            <input
                                                                type="checkbox"
                                                                class="r3d-extra-option"
                                                                t-att-data-price="config.price"
                                                                t-att-data-option-name="config.option_id.name"
                                                                t-att-data-configuration-id="config.id"/>


                                                            <!-- CABECERA -->

                                                            <div class="r3d-config-card-top">

                                                                <span class="r3d-config-card-status">
                                                                    OPCIONAL
                                                                </span>

                                                                <span class="r3d-config-card-selector">
                                                                </span>

                                                            </div>


                                                            <!-- CUERPO -->

                                                            <div class="r3d-config-card-body">


                                                                <!-- IMAGEN -->

                                                                <div class="r3d-config-card-image">

                                                                    <span>
                                                                        IMAGEN
                                                                    </span>

                                                                </div>


                                                                <!-- INFORMACIÓN -->

                                                                <div class="r3d-config-card-content">

                                                                    <h3>
                                                                        <t t-esc="config.option_id.name"/>
                                                                    </h3>

                                                                    <p>
                                                                        Lorem ipsum dolor sit amet,
                                                                        consectetur adipiscing elit.
                                                                        Sed do eiusmod tempor incididunt
                                                                        ut labore et dolore magna aliqua.
                                                                    </p>


                                                                    <t t-if="config.price">

                                                                        <strong class="r3d-config-card-price">

                                                                            +
                                                                            <t t-esc="'{:,.2f} €'.format(config.price)"/>

                                                                        </strong>

                                                                    </t>

                                                                </div>

                                                            </div>

                                                        </label>

                                                    </t>

                                                </t>

                                            </div>

                                        </div>

                                    </t>

                                </div>

                            </div>


                            <!-- =================================================
                                 COLUMNA DERECHA
                                 RESUMEN STICKY
                                 ================================================= -->

                            <div class="r3d-configurator-right">

                                <aside class="r3d-summary">

                                    <div class="r3d-summary-label">
                                        TU CONFIGURACIÓN
                                    </div>


                                    <t t-if="machines">


                                        <!-- NOMBRE DE LA MÁQUINA -->

                                        <h2>
                                            <t t-esc="machines[0].name"/>
                                        </h2>


                                        <!-- =====================================
                                             RESUMEN DE EQUIPAMIENTO
                                             ===================================== -->

                                        <div class="r3d-summary-configurations">

                                            <t t-foreach="machines" t-as="machine">

                                                <div
                                                    t-att-class="'r3d-summary-machine-options active' if machine == machines[:1] else 'r3d-summary-machine-options'"
                                                    t-att-data-machine-id="machine.id">

                                                    <h3>
                                                        EQUIPAMIENTO
                                                    </h3>

                                                    <t
                                                        t-foreach="machine.configuration_ids"
                                                        t-as="config">

                                                        <t t-if="config.available">


                                                            <!-- OPCIÓN INCLUIDA -->

                                                            <div
                                                                t-if="config.included"
                                                                class="r3d-summary-option r3d-summary-option-included"
                                                                t-att-data-configuration-id="config.id">

                                                                <span class="r3d-summary-check active">
                                                                    ✓
                                                                </span>

                                                                <span class="r3d-summary-option-name">
                                                                    <t t-esc="config.option_id.name"/>
                                                                </span>

                                                                <strong>
                                                                    INCLUIDO
                                                                </strong>

                                                            </div>


                                                            <!-- OPCIÓN SELECCIONABLE -->

                                                            <div
                                                                t-else=""
                                                                class="r3d-summary-option r3d-summary-option-selectable"
                                                                t-att-data-configuration-id="config.id">

                                                                <span class="r3d-summary-check">
                                                                    ✓
                                                                </span>

                                                                <span class="r3d-summary-option-name">
                                                                    <t t-esc="config.option_id.name"/>
                                                                </span>

                                                                <strong class="r3d-summary-option-price">
                                                                    +
                                                                    <t t-esc="'{:,.2f} €'.format(config.price)"/>
                                                                </strong>

                                                            </div>

                                                        </t>

                                                    </t>

                                                </div>

                                            </t>

                                        </div>


                                        <!-- =====================================
                                             PRECIO
                                             ===================================== -->

                                        <div class="r3d-total">

                                            <span>
                                                PRECIO
                                            </span>

                                            <strong>
                                                <t t-esc="'{:,.2f} €'.format(machines[0].base_price)"/>
                                            </strong>

                                        </div>

                                    </t>


                                    <!-- =========================================
                                         SOLICITAR OFERTA
                                         ========================================= -->

                                    <button
                                        type="button"
                                        class="r3d-quote-button">

                                        SOLICITAR OFERTA

                                    </button>


                                    <!-- =========================================
                                         FORMULARIO
                                         ========================================= -->

                                    <div
                                        class="r3d-quote-form"
                                        style="display: none;">


                                        <div class="r3d-quote-form-header">

                                            <h3>
                                                Solicitar oferta
                                            </h3>

                                            <button
                                                type="button"
                                                class="r3d-quote-close">

                                                ×

                                            </button>

                                        </div>


                                        <p class="r3d-quote-intro">

                                            Déjanos tus datos y te enviaremos una
                                            propuesta adaptada a la configuración
                                            seleccionada.

                                        </p>


                                        <!-- NOMBRE -->

                                        <div class="r3d-form-field">

                                            <label>
                                                Nombre *
                                            </label>

                                            <input
                                                type="text"
                                                name="customer_name"
                                                required="required"/>

                                        </div>


                                        <!-- EMPRESA -->

                                        <div class="r3d-form-field">

                                            <label>
                                                Empresa
                                            </label>

                                            <input
                                                type="text"
                                                name="company_name"/>

                                        </div>


                                        <!-- EMAIL -->

                                        <div class="r3d-form-field">

                                            <label>
                                                Email *
                                            </label>

                                            <input
                                                type="email"
                                                name="email"
                                                required="required"/>

                                        </div>


                                        <!-- TELÉFONO -->

                                        <div class="r3d-form-field">

                                            <label>
                                                Teléfono
                                            </label>

                                            <input
                                                type="tel"
                                                name="phone"/>

                                        </div>


                                        <!-- COMENTARIOS -->

                                        <div class="r3d-form-field">

                                            <label>
                                                Comentarios
                                            </label>

                                            <textarea
                                                name="comments"
                                                rows="4"></textarea>

                                        </div>


                                        <!-- ENVIAR -->

                                        <button
                                            type="button"
                                            class="r3d-quote-submit">

                                            ENVIAR SOLICITUD

                                        </button>

                                    </div>

                                </aside>

                            </div>

                        </div>

                    </div>

                </section>

            </div>

        </t>

    </template>

</odoo>